# Secrets — never commit this file.
# Copy to .env and fill in real values.

# Django
DJANGO_SECRET_KEY=change-me-to-a-random-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# MySQL or PostgreSQL. Default "mysql" (matches local dev / report);
# set "postgres" in production.
DB_ENGINE=mysql
DB_NAME=civicsense
DB_USER=civicsense
DB_PASSWORD=CivicSense2026!dev
DB_HOST=127.0.0.1
DB_PORT=3306
# SSL mode for PostgreSQL (e.g. "require" on Render/Neon)
DB_SSLMODE=require

# Cloudinary (deploy only) — photos persist via the CDN; leave blank for local disk uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# AI micro-service
AI_SERVICE_URL=http://localhost:8001

# LLM (provider-agnostic via LiteLLM). Leave blank to use the offline rule-based fallback.
LLM_MODEL=
LLM_API_KEY=
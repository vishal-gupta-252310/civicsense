# Secrets — never commit this file.
# Copy to .env and fill in real values.

# Django
DJANGO_SECRET_KEY=change-me-to-a-random-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# MySQL or PostgreSQL. Default "mysql" (matches local dev / report);
# set "postgres" in production.
DB_ENGINE=mysql
DB_NAME=civicsense
DB_USER=civicsense
DB_PASSWORD=CivicSense2026!dev
DB_HOST=127.0.0.1
DB_PORT=3306
# SSL mode for PostgreSQL (e.g. "require" on Render/Neon)
DB_SSLMODE=require

# Cloudinary (deploy only) — photos persist via the CDN; leave blank for local disk uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# AI micro-service
AI_SERVICE_URL=http://localhost:8001

# LLM (default provider/model + key used when a user has no per-user settings).
# Leave blank to use the offline rule-based fallback.
LLM_MODEL=
LLM_API_KEY=

# Email (password reset). Console backend prints reset links to the server log;
# switch to these SMTP values with real credentials to send actual emails.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true

# Public site URL used as the domain in reset emails (never the request Host).
SITE_URL=https://civicsense-django.onrender.com